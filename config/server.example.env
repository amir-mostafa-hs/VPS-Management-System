# ==============================================================================
# server.example.env — Server Configuration Template
# ==============================================================================
# Copy this file to server.env on the VPS and configure your server parameters.
# Never commit server.env to Git!

# Server Hostname and Identification
SERVER_HOSTNAME=vps-production
OPERATOR_EMAIL=admin@example.com

# SSH Port Configuration (default is 22)
SSH_PORT=22

# Firewall & Security Settings
UFW_ENABLED=true
FAIL2BAN_ENABLED=true

# Additional allowed ports (space-separated, e.g. "8080/tcp 53/udp")
# You can also define custom ports in config/allowed_ports.conf
CUSTOM_ALLOWED_PORTS=""

# Automatic Security Updates (unattended-upgrades)
AUTO_UPDATES_ENABLED=true
