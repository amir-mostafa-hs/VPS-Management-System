# ==============================================================================
# backup.example.env — Automated Off-Site Backup Configuration
# ==============================================================================
# Copy this file to backup.env on the VPS and configure your backup parameters.
# Never commit backup.env to Git!

# Rclone Remote Destination
# Name of the encrypted rclone remote configured via 'rclone config'
# e.g. "gdrive-crypt:vps-backups"
RCLONE_REMOTE="gdrive-crypt:vps-backups"

# Staging Directory on the VPS (permissions 0700)
BACKUP_STAGING_DIR="/var/backups/vps"

# Retention Policy (days to keep backups locally and in remote)
LOCAL_RETENTION_DAYS=7
REMOTE_RETENTION_DAYS=30

# Tier 1: Coolify Core Backup
BACKUP_COOLIFY_ENABLED=true
COOLIFY_DATA_DIR="/data/coolify"

# Tier 2: Application Databases (Space-separated container names)
# Native pg_dump will be invoked for PostgreSQL containers
POSTGRES_CONTAINERS="coolify-db"
POSTGRES_USER="postgres"
POSTGRES_DB="coolify"

# Native mysqldump will be invoked for MySQL containers
MYSQL_CONTAINERS=""
MYSQL_USER="root"

# Tier 2: Targeted Docker Volumes and Paths (Space-separated directory paths)
APPLICATION_DATA_PATHS=""

# Health / Notification Webhook (Optional)
# Webhook URL to call on backup success or failure (e.g. Discord, Telegram, healthchecks.io)
BACKUP_ALERT_WEBHOOK=""

